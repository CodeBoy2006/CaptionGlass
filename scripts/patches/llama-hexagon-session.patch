 // Flush HTP response queue i.e wait for all outstanding requests to complete
+void ggml_hexagon_session::fail(const char * reason) {
+    if (!failed) {
+        // Stop this application's remote process before its shared buffers can be freed.
+        // remote.h specifies PROCESS_KILL for a remote invocation that does not return.
+        remote_rpc_process_clean_params params{static_cast<int>(domain_id)};
+        const int err = remote_session_control(FASTRPC_REMOTE_PROCESS_KILL, &params, sizeof(params));
+        if (err != AEE_SUCCESS) {
+            // Fail closed: returning would allow freeing buffers still owned by the DSP.
+            GGML_ABORT("ggml-hex: cannot stop failed DSP safely: %s (kill=0x%x)\n", reason, err);
+        }
+        failed = true;
+        valid_iface = false;
+    }
+    throw std::runtime_error(reason);
+}
